# ============================================================================
# Configuration d'environnement pour UniPay Backend API
# ============================================================================
# Copier ce fichier en .env et adapter les valeurs selon votre environnement

# Environnement: development, staging, production
APP_ENV=development

# ============================================================================
# Base de données PostgreSQL
# ============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=unipay_db
DB_USER=unipay_admin
DB_PASS=root1234
DB_CHARSET=utf8mb4

# ============================================================================
# Serveur
# ============================================================================
SERVER_HOST=localhost
SERVER_PORT=8000
SERVER_URL=http://localhost:8000

# En production:
# SERVER_URL=https://api.unipay.example.com

# ============================================================================
# CORS
# ============================================================================
# Domaines autorisés (séparés par virgules)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:5000

# En production:
# CORS_ALLOWED_ORIGINS=https://unipay.example.com,https://app.unipay.example.com

# ============================================================================
# Logging
# ============================================================================
LOG_ENABLED=true
LOG_PATH=./logs
LOG_LEVEL=DEBUG

# En production:
# LOG_LEVEL=WARNING

# ============================================================================
# API
# ============================================================================
API_TIMEOUT=30
API_MAX_PAYLOAD=1048576

# ============================================================================
# Email (optionnel pour notifications)
# ============================================================================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=notifications@unipay.example.com
# SMTP_PASS=your_password
# SMTP_FROM=notifications@unipay.example.com

# ============================================================================
# SMS (optionnel pour notifications)
# ============================================================================
# SMS_PROVIDER=twilio
# SMS_API_KEY=your_api_key
# SMS_API_SECRET=your_api_secret

# ============================================================================
# Sécurité
# ============================================================================
# Clé pour les tokens JWT (si utilisation d'authentification)
# JWT_SECRET=your_super_secret_jwt_key_change_in_production

# CORS strict en production
# CORS_STRICT=true

# HTTPS en production
# HTTPS_ONLY=true
